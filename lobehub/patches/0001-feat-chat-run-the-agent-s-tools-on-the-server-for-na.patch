+import {
+  createDefaultGlobalAudits,
+  DEFAULT_SECURITY_BLACKLIST,
+  InterventionChecker,
+} from '@lobechat/agent-runtime';
+import type { LobeToolManifest } from '@lobechat/context-engine';
+import type {
+  ChatToolPayload,
+  HumanInterventionConfig,
+  HumanInterventionPolicy,
+  UserInterventionConfig,
+} from '@lobechat/types';
+import { isRecord } from '@lobechat/utils/object';
+
+export const APPROVAL_UNAVAILABLE_RESULT =
+  'This tool call was not executed: it requires the user to approve it, and this client cannot show approval requests yet. Tell the user to run this request from the LobeHub web or desktop app if they want to approve it.';
+
+const POLICY_RANK: Record<HumanInterventionPolicy, number> = { always: 2, never: 0, required: 1 };
+
+const parseArgs = (raw: string | undefined): Record<string, unknown> => {
+  try {
+    const parsed = JSON.parse(raw || '{}');
+    return isRecord(parsed) ? parsed : {};
+  } catch {
+    return {};
+  }
+};
+
+/**
+ * Whether the call would stop for human approval in the server agent runtime.
+ *
+ * Mirrors `GeneralChatAgent.checkInterventionNeeded` for a client that cannot
+ * approve anything: every call that would wait there is refused here, never
+ * auto-approved. The one deliberate difference is on the safe side — dynamic
+ * intervention configs need resolvers only the runtime has, so they always
+ * count as needing approval.
+ */
+export const requiresHumanApproval = async (
+  toolCall: Pick<ChatToolPayload, 'apiName' | 'arguments' | 'identifier'>,
+  manifest: LobeToolManifest | undefined,
+  userConfig: UserInterventionConfig | undefined,
+): Promise<boolean> => {
+  const { apiName, identifier } = toolCall;
+  const args = parseArgs(toolCall.arguments);
+  const { allowList = [], approvalMode = 'manual' } = userConfig ?? {};
+
+  let globalPolicy: HumanInterventionPolicy | undefined;
+  for (const audit of createDefaultGlobalAudits()) {
+    if (await audit.resolver(args, { securityBlacklist: DEFAULT_SECURITY_BLACKLIST })) {
+      const policy = audit.policy ?? 'always';
+      if (!globalPolicy || POLICY_RANK[policy] > POLICY_RANK[globalPolicy]) globalPolicy = policy;
+    }
+  }
+  if (globalPolicy === 'always') return true;
+
+  const api = manifest?.api?.find((item) => item.name === apiName);
+  const config =
+    (api as { humanIntervention?: unknown } | undefined)?.humanIntervention ??
+    (manifest as { humanIntervention?: unknown } | undefined)?.humanIntervention;
+  if (isRecord(config) && 'dynamic' in config) return true;
+
+  const staticPolicy = InterventionChecker.shouldIntervene({
+    config: config as HumanInterventionConfig | undefined,
+    securityBlacklist: [],
+    toolArgs: args,
+  });
+  if (staticPolicy === 'always') return true;
+
+  if (approvalMode === 'auto-run' || approvalMode === 'headless') return false;
+  if (globalPolicy === 'required') return true;
+  if (!manifest) return true;
+  if (approvalMode === 'allow-list') return !allowList.includes(`${identifier}/${apiName}`);
+
+  return staticPolicy !== 'never';
+};
