+// @vitest-environment node
+import type { ChatMethodOptions } from '@lobechat/model-runtime';
+import type { ChatStreamPayload, MessageToolCall } from '@lobechat/types';
+import { TraceNameMap } from '@lobechat/types';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { resolveChatCompletionToolSet } from '@/server/services/aiAgent/pipeline/chatCompletionToolSet';
+import { ToolExecutionService } from '@/server/services/toolExecution';
+
+import { chatWithNativeMobileTools } from '../index';
+import { APPROVAL_UNAVAILABLE_RESULT } from '../toolCallPolicy';
+
+const topicState = vi.hoisted(() => ({ topic: undefined as unknown }));
+const settingsState = vi.hoisted(() => ({ settings: undefined as unknown }));
+
+vi.mock('@/database/models/topic', () => ({
+  TopicModel: vi.fn(function () {
+    return { findById: async () => topicState.topic };
+  }),
+}));
+vi.mock('@/database/models/user', () => ({
+  UserModel: vi.fn(function () {
+    return { getUserSettings: async () => settingsState.settings };
+  }),
+}));
+vi.mock('@/server/services/agentDocuments', () => ({ AgentDocumentsService: vi.fn() }));
+vi.mock('@/server/services/aiAgent/pipeline/chatCompletionToolSet', () => ({
+  resolveChatCompletionToolSet: vi.fn(),
+}));
+
+const toolName = 'meteoblue____getWeather____mcp';
+const meteoblueManifest = {
+  api: [{ description: '', name: 'getWeather', parameters: { type: 'object' } }],
+  identifier: 'meteoblue',
+  meta: { title: 'meteoblue' },
+  type: 'mcp',
+};
+const toolSet = {
+  manifestMap: { meteoblue: meteoblueManifest },
+  sourceMap: {},
+  tools: [{ function: { name: toolName, parameters: { type: 'object' } }, type: 'function' }],
+} as any;
+const weatherCall: MessageToolCall = {
+  function: { arguments: '{"city":"Paris"}', name: toolName },
+  id: 'call_1',
+  type: 'function',
+};
+
+const sseResponse = (events: [string, unknown][]) =>
+  new Response(
+    events.map(([e, d]) => `id: 1\nevent: ${e}\ndata: ${JSON.stringify(d)}\n\n`).join(''),
+  );
+
+/** First step asks for the weather tool, the second answers with its result. */
+const createModelRuntime = () => {
+  const payloads: ChatStreamPayload[] = [];
+  const chat = vi.fn(async (payload: ChatStreamPayload, options?: ChatMethodOptions) => {
+    payloads.push(payload);
+    if (payloads.length === 1) {
+      await options?.callback?.onToolsCalling?.({ chunk: [], toolsCalling: [weatherCall] });
+      await options?.callback?.onCompletion?.({ text: '', toolsCalling: [weatherCall] });
+      return sseResponse([['stop', 'tool_calls']]);
+    }
+    await options?.callback?.onCompletion?.({ text: 'done' });
+    return sseResponse([
+      ['text', 'done'],
+      ['stop', 'stop'],
+    ]);
+  });
+  return { modelRuntime: { chat } as any, payloads };
+};
+
+const baseParams = () => ({
+  chatOptions: { metadata: {}, user: 'user_1' },
+  headers: new Headers({ 'user-agent': 'LobeHub-Mobile/android-v1.0.22' }),
+  payload: {
+    messages: [{ content: 'Weather in Paris?', role: 'user' }],
+    model: 'deepseek/deepseek-v4.1-flash',
+    stream: true,
+    temperature: 1,
+  } as ChatStreamPayload,
+  provider: 'commandcode',
+  serverDB: {} as any,
+  trace: {
+    enabled: false,
+    sessionId: 'agt_1',
+    topicId: 'tpc_1',
+    traceName: TraceNameMap.Conversation,
+  },
+  userId: 'user_1',
+});
+
+beforeEach(() => {
+  topicState.topic = { agentId: 'agt_1', id: 'tpc_1' };
+  settingsState.settings = undefined;
+  vi.mocked(resolveChatCompletionToolSet).mockResolvedValue(toolSet);
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.clearAllMocks();
+});
+
+describe('chatWithNativeMobileTools', () => {
+  it('runs an enabled tool on the server for a native mobile turn', async () => {
+    const executeTool = vi
+      .spyOn(ToolExecutionService.prototype, 'executeTool')
+      .mockResolvedValue({ content: '{"temperature":20}', executionTime: 1, success: true });
+    const { modelRuntime, payloads } = createModelRuntime();
+
+    const response = await chatWithNativeMobileTools({ ...baseParams(), modelRuntime });
+    const body = await response!.text();
+
+    expect(body).toContain('"done"');
+    expect(body).not.toContain('tool_calls');
+    expect(payloads[0].tools).toEqual(toolSet.tools);
+    expect(executeTool).toHaveBeenCalledWith(
+      expect.objectContaining({ apiName: 'getWeather', identifier: 'meteoblue' }),
+      expect.objectContaining({ agentId: 'agt_1', topicId: 'tpc_1', userId: 'user_1' }),
+    );
+    expect(payloads[1].messages.at(-1)).toMatchObject({
+      content: '{"temperature":20}',
+      role: 'tool',
+    });
+  });
+
+  it('refuses a tool that needs approval instead of running it', async () => {
+    vi.mocked(resolveChatCompletionToolSet).mockResolvedValue({
+      ...toolSet,
+      manifestMap: {
+        meteoblue: {
+          ...meteoblueManifest,
+          api: [{ ...meteoblueManifest.api[0], humanIntervention: 'required' }],
+        },
+      },
+    });
+    const executeTool = vi.spyOn(ToolExecutionService.prototype, 'executeTool');
+    const { modelRuntime, payloads } = createModelRuntime();
+
+    const response = await chatWithNativeMobileTools({ ...baseParams(), modelRuntime });
+    await response!.text();
+
+    expect(executeTool).not.toHaveBeenCalled();
+    expect(payloads[1].messages.at(-1)).toMatchObject({
+      content: APPROVAL_UNAVAILABLE_RESULT,
+      role: 'tool',
+    });
+  });
+
+  it('serves web requests as plain completions', async () => {
+    const { modelRuntime } = createModelRuntime();
+
+    const response = await chatWithNativeMobileTools({
+      ...baseParams(),
+      headers: new Headers({ 'user-agent': 'Mozilla/5.0' }),
+      modelRuntime,
+    });
+
+    expect(response).toBeUndefined();
+    expect(resolveChatCompletionToolSet).not.toHaveBeenCalled();
+  });
+
+  it('does not trust a trace header naming another agent’s topic', async () => {
+    topicState.topic = { agentId: 'agt_other', id: 'tpc_1' };
+    const { modelRuntime } = createModelRuntime();
+
+    expect(await chatWithNativeMobileTools({ ...baseParams(), modelRuntime })).toBeUndefined();
+    expect(resolveChatCompletionToolSet).not.toHaveBeenCalled();
+  });
+
+  it('does not trust a trace header naming a topic the caller cannot read', async () => {
+    topicState.topic = undefined;
+    const { modelRuntime } = createModelRuntime();
+
+    expect(await chatWithNativeMobileTools({ ...baseParams(), modelRuntime })).toBeUndefined();
+  });
+
+  it('falls back to a plain completion when tool discovery fails', async () => {
+    vi.mocked(resolveChatCompletionToolSet).mockRejectedValue(new Error('Agent not found'));
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    const { modelRuntime } = createModelRuntime();
+
+    expect(await chatWithNativeMobileTools({ ...baseParams(), modelRuntime })).toBeUndefined();
+    expect(modelRuntime.chat).not.toHaveBeenCalled();
+  });
+
+  it('falls back to a plain completion when the agent has no runnable tools', async () => {
+    vi.mocked(resolveChatCompletionToolSet).mockResolvedValue({
+      manifestMap: {},
+      sourceMap: {},
+      tools: [],
+    });
+    const { modelRuntime } = createModelRuntime();
+
+    expect(await chatWithNativeMobileTools({ ...baseParams(), modelRuntime })).toBeUndefined();
+  });
+});
