@@ -0,0 +1,329 @@
+import type { ChatMethodOptions, OnFinishData } from '@lobechat/model-runtime';
+import type { ChatStreamPayload, MessageToolCall, OpenAIChatMessage } from '@lobechat/types';
+import { isRecord } from '@lobechat/utils/object';
+
+/** Model calls per request, tool rounds included. */
+export const MAX_TOOL_LOOP_STEPS = 10;
+
+export const TOOL_STEP_LIMIT_NOTICE = `\n\n(Stopped after ${MAX_TOOL_LOOP_STEPS} tool steps.)`;
+
+export type ToolLoopChat = (
+  payload: ChatStreamPayload,
+  callback: NonNullable<ChatMethodOptions['callback']>,
+  signal: AbortSignal,
+) => Promise<Response>;
+
+/** Resolves to the content handed back to the model as the tool result. */
+export type ToolLoopExecuteToolCall = (
+  toolCall: MessageToolCall,
+  signal: AbortSignal,
+) => Promise<string>;
+
+export interface RunChatToolLoopParams {
+  chat: ToolLoopChat;
+  executeToolCall: ToolLoopExecuteToolCall;
+  maxSteps?: number;
+  /** Request payload with the offered `tools` already set. */
+  payload: ChatStreamPayload;
+  signal?: AbortSignal;
+}
+
+interface SSEEvent {
+  data?: unknown;
+  event?: string;
+  raw: string;
+}
+
+/**
+ * Held until the whole response is known. Reasoning signatures and Responses
+ * items describe ONE provider response; a multi-step answer concatenates the
+ * reasoning of several, so replaying any single signature against it on the
+ * next turn would be rejected by the provider.
+ */
+const PER_RESPONSE_EVENTS = new Set([
+  'flagged_reasoning_signature',
+  'reasoning_response_item',
+  'reasoning_signature',
+]);
+
+const encoder = new TextEncoder();
+
+const parseEvent = (raw: string): SSEEvent => {
+  let event: string | undefined;
+  let dataText: string | undefined;
+  for (const line of raw.split('\n')) {
+    if (line.startsWith('event:')) event = line.slice(6).trim();
+    else if (line.startsWith('data:')) dataText = line.slice(5).trim();
+  }
+
+  let data: unknown;
+  if (dataText !== undefined) {
+    try {
+      data = JSON.parse(dataText);
+    } catch {
+      data = dataText;
+    }
+  }
+  return { data, event, raw };
+};
+
+const formatEvent = (id: string, event: string, data: unknown) =>
+  `id: ${id}\nevent: ${event}\ndata: ${JSON.stringify(data)}\n\n`;
+
+async function* readEvents(body: ReadableStream<Uint8Array>): AsyncGenerator<SSEEvent> {
+  const reader = body.getReader();
+  const decoder = new TextDecoder();
+  let buffer = '';
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      buffer += done ? decoder.decode() : decoder.decode(value, { stream: true });
+
+      let boundary = buffer.indexOf('\n\n');
+      while (boundary !== -1) {
+        const raw = buffer.slice(0, boundary);
+        buffer = buffer.slice(boundary + 2);
+        if (raw.trim()) yield parseEvent(raw);
+        boundary = buffer.indexOf('\n\n');
+      }
+
+      if (done) break;
+    }
+    if (buffer.trim()) yield parseEvent(buffer);
+  } finally {
+    reader.releaseLock();
+  }
+}
+
+/** Token counts and costs add up across steps; anything else keeps the latest value. */
+const mergeUsage = (total: unknown, next: unknown) => {
+  if (!isRecord(total) || !isRecord(next)) return next;
+
+  const merged: Record<string, unknown> = { ...total };
+  for (const [key, value] of Object.entries(next)) {
+    const previous = merged[key];
+    merged[key] =
+      typeof value === 'number' && typeof previous === 'number' ? previous + value : value;
+  }
+  return merged;
+};
+
+const toErrorEventData = (error: unknown) => {
+  const payload = isRecord(error) ? error : {};
+  const errorType = typeof payload.errorType === 'string' ? payload.errorType : undefined;
+  const inner = payload.error ?? error;
+  const message =
+    inner instanceof Error
+      ? inner.message
+      : isRecord(inner) && typeof inner.message === 'string'
+        ? inner.message
+        : String(inner);
+
+  return {
+    body: isRecord(inner) ? inner : { message },
+    message,
+    type: errorType ?? 'AgentRuntimeError',
+  };
+};
+
+interface StepOutcome {
+  completion?: OnFinishData;
+  toolCalls: MessageToolCall[];
+}
+
+/**
+ * Serve one chat completion request with a server-side tool loop, for clients
+ * that stream `/webapi/chat` but cannot execute tool calls themselves.
+ *
+ * The client receives a single ordinary completion stream: text, reasoning and
+ * the other content events of every step are forwarded as they arrive, while
+ * `tool_calls` never reach it (it has nothing to run them with) and the
+ * terminal `stop` / `usage` / `speed` events are sent once, after the last
+ * step, with usage summed over all steps. The tool calls and their results live
+ * only inside this request; the client persists the final answer as usual.
+ *
+ * The first model call is awaited before the response is returned, so a
+ * provider rejection surfaces through the caller's normal error response.
+ */
+export const runChatToolLoop = async ({
+  chat,
+  executeToolCall,
+  maxSteps = MAX_TOOL_LOOP_STEPS,
+  payload,
+  signal,
+}: RunChatToolLoopParams): Promise<Response> => {
+  const abortController = new AbortController();
+  const abort = () => abortController.abort(signal?.reason);
+  if (signal?.aborted) abort();
+  else signal?.addEventListener('abort', abort, { once: true });
+  const loopSignal = abortController.signal;
+
+  const messages: OpenAIChatMessage[] = [...payload.messages];
+
+  let outcome: StepOutcome = { toolCalls: [] };
+  const startStep = () => {
+    outcome = { toolCalls: [] };
+    const step = outcome;
+    return chat(
+      { ...payload, messages: [...messages] },
+      {
+        onCompletion: (data) => {
+          step.completion = data;
+        },
+        onToolsCalling: ({ toolsCalling }) => {
+          step.toolCalls = toolsCalling;
+        },
+      },
+      loopSignal,
+    );
+  };
+
+  let response: Response;
+  try {
+    response = await startStep();
+  } catch (error) {
+    signal?.removeEventListener('abort', abort);
+    throw error;
+  }
+  if (!response.ok || !response.body) {
+    signal?.removeEventListener('abort', abort);
+    return response;
+  }
+
+  let firstResponse: Response | undefined = response;
+
+  const stream = new ReadableStream<Uint8Array>({
+    cancel: () => abortController.abort(),
+    start: async (controller) => {
+      const send = (text: string) => {
+        // A cancelled reader closes the controller; the loop only has to wind down.
+        if (loopSignal.aborted) return;
+        controller.enqueue(encoder.encode(text));
+      };
+
+      let lastId = 'chat';
+      let hasText = false;
+      let usage: unknown;
+      let speed: SSEEvent | undefined;
+      let stop: SSEEvent | undefined;
+      let heldPerResponse: SSEEvent[] = [];
+      let steps = 0;
+      let errored = false;
+
+      try {
+        while (true) {
+          const current = firstResponse ?? (await startStep());
+          firstResponse = undefined;
+          steps += 1;
+          if (!current.body) break;
+
+          const separateFromPreviousStep = hasText;
+          let stepHasText = false;
+
+          for await (const event of readEvents(current.body)) {
+            const idLine = event.raw.split('\n').find((line) => line.startsWith('id:'));
+            if (idLine) lastId = idLine.slice(3).trim() || lastId;
+
+            switch (event.event) {
+              case 'tool_calls': {
+                break;
+              }
+              case 'stop': {
+                stop = event;
+                break;
+              }
+              case 'usage': {
+                usage = mergeUsage(usage, event.data);
+                break;
+              }
+              case 'speed': {
+                speed = event;
+                break;
+              }
+              case 'text': {
+                if (typeof event.data === 'string' && event.data) {
+                  if (separateFromPreviousStep && !stepHasText) {
+                    send(formatEvent(lastId, 'text', '\n\n'));
+                  }
+                  stepHasText = true;
+                  hasText = true;
+                }
+                send(`${event.raw}\n\n`);
+                break;
+              }
+              case 'error': {
+                errored = true;
+                send(`${event.raw}\n\n`);
+                break;
+              }
+              default: {
+                if (event.event && PER_RESPONSE_EVENTS.has(event.event)) {
+                  heldPerResponse.push(event);
+                } else {
+                  send(`${event.raw}\n\n`);
+                }
+              }
+            }
+          }
+
+          if (errored || loopSignal.aborted) break;
+
+          const toolCalls = outcome.toolCalls.length
+            ? outcome.toolCalls
+            : (outcome.completion?.toolsCalling ?? []);
+          if (toolCalls.length === 0) break;
+
+          if (steps >= maxSteps) {
+            send(formatEvent(lastId, 'text', TOOL_STEP_LIMIT_NOTICE));
+            break;
+          }
+
+          messages.push({
+            content: outcome.completion?.text ?? '',
+            reasoning: outcome.completion?.reasoning,
+            role: 'assistant',
+            tool_calls: toolCalls,
+          });
+          for (const toolCall of toolCalls) {
+            let content: string;
+            try {
+              content = await executeToolCall(toolCall, loopSignal);
+            } catch (error) {
+              content = `Tool execution failed: ${(error as Error)?.message ?? String(error)}`;
+            }
+            if (loopSignal.aborted) break;
+            messages.push({
+              content,
+              name: toolCall.function.name,
+              role: 'tool',
+              tool_call_id: toolCall.id,
+            });
+          }
+          if (loopSignal.aborted) break;
+        }
+
+        if (!errored) {
+          if (steps === 1) for (const event of heldPerResponse) send(`${event.raw}\n\n`);
+          heldPerResponse = [];
+          if (stop) send(`${stop.raw}\n\n`);
+          if (usage !== undefined) send(formatEvent(lastId, 'usage', usage));
+          if (speed) send(`${speed.raw}\n\n`);
+        }
+      } catch (error) {
+        if (!loopSignal.aborted) {
+          console.error('[nativeMobileChat] tool loop failed:', error);
+          send(formatEvent(lastId, 'error', toErrorEventData(error)));
+        }
+      } finally {
+        signal?.removeEventListener('abort', abort);
+        try {
+          controller.close();
+        } catch {
+          // Already closed by a cancelled reader.
+        }
+      }
+    },
+  });
+
+  return new Response(stream, { headers: response.headers, status: response.status });
+};
