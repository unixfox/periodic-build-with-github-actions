+// @vitest-environment node
+import { ToolNameResolver } from '@lobechat/context-engine';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { resolveChatCompletionToolSet } from '../chatCompletionToolSet';
+import { discoverTools } from '../toolDiscovery';
+
+vi.mock('../toolDiscovery', () => ({ discoverTools: vi.fn() }));
+
+const resolver = new ToolNameResolver();
+
+const manifest = (identifier: string, type?: string) => ({
+  api: [{ description: '', name: 'call', parameters: { type: 'object' } }],
+  identifier,
+  meta: { title: identifier },
+  ...(type && { type }),
+});
+
+const tool = (identifier: string, type?: string) => ({
+  function: { name: resolver.generate(identifier, 'call', type), parameters: { type: 'object' } },
+  type: 'function' as const,
+});
+
+const deps = {
+  resolveAgentConfig: vi.fn(async () => ({
+    agentConfig: { id: 'agt_1', plugins: ['meteoblue'] } as any,
+    disabledPluginIds: ['disabled-mcp'],
+  })),
+} as any;
+
+const input = {
+  agentId: 'agt_1',
+  model: 'deepseek/deepseek-v4.1-flash',
+  prompt: 'Weather in Paris?',
+  provider: 'commandcode',
+  topicId: 'tpc_1',
+};
+
+afterEach(() => {
+  vi.clearAllMocks();
+});
+
+describe('resolveChatCompletionToolSet', () => {
+  it('offers only enabled tools a bare request can execute', async () => {
+    vi.mocked(discoverTools).mockResolvedValue({
+      toolExecutorMap: { 'stdio-mcp': 'client' },
+      toolManifestMap: {
+        'composio-gmail': manifest('composio-gmail'),
+        'discoverable-mcp': manifest('discoverable-mcp', 'mcp'),
+        'legacy-plugin': manifest('legacy-plugin', 'default'),
+        'lobe-web-browsing': manifest('lobe-web-browsing', 'builtin'),
+        'meteoblue': manifest('meteoblue', 'mcp'),
+        'skill-github': manifest('skill-github'),
+        'stdio-mcp': manifest('stdio-mcp', 'mcp'),
+      },
+      toolSourceMap: { 'composio-gmail': 'composio', 'skill-github': 'lobehubSkill' },
+      tools: [
+        tool('composio-gmail'),
+        tool('legacy-plugin'),
+        tool('lobe-web-browsing'),
+        tool('meteoblue', 'mcp'),
+        tool('skill-github'),
+        tool('stdio-mcp', 'mcp'),
+      ],
+    } as any);
+
+    const toolSet = await resolveChatCompletionToolSet(deps, input);
+
+    expect(toolSet.tools.map((item) => item.function.name)).toEqual([
+      tool('composio-gmail').function.name,
+      tool('meteoblue', 'mcp').function.name,
+      tool('skill-github').function.name,
+    ]);
+    // Only offered tools resolve: the activator-discoverable MCP stays out.
+    expect(Object.keys(toolSet.manifestMap).sort()).toEqual([
+      'composio-gmail',
+      'meteoblue',
+      'skill-github',
+    ]);
+  });
+
+  it('runs discovery for the requested model without device tools', async () => {
+    vi.mocked(discoverTools).mockResolvedValue({
+      toolExecutorMap: {},
+      toolManifestMap: {},
+      toolSourceMap: {},
+      tools: undefined,
+    } as any);
+
+    const toolSet = await resolveChatCompletionToolSet(deps, input);
+
+    expect(toolSet.tools).toEqual([]);
+    expect(deps.resolveAgentConfig).toHaveBeenCalledWith('agt_1', {
+      model: input.model,
+      provider: input.provider,
+    });
+    const [, ctx, discoveryInput] = vi.mocked(discoverTools).mock.calls[0];
+    expect(ctx).toMatchObject({ canUseDevice: false, model: input.model, topicId: 'tpc_1' });
+    expect(discoveryInput).toMatchObject({
+      disableLocalSystem: true,
+      disabledPluginIds: ['disabled-mcp'],
+      isFixedDeviceTarget: false,
+    });
+  });
+});
diff --git a/apps/server/src/services/aiAgent/pipeline/chatCompletionToolSet.ts b/apps/server/src/services/aiAgent/pipeline/chatCompletionToolSet.ts
new file mode 100644
index 0000000000..0b796a77b6
--- /dev/null
+++ b/apps/server/src/services/aiAgent/pipeline/chatCompletionToolSet.ts
@@ -0,0 +1,132 @@
+import { isBuiltinToolIdentifier } from '@lobechat/builtin-tools';
+import type { LobeToolManifest, ToolSource } from '@lobechat/context-engine';
+import { ToolNameResolver } from '@lobechat/context-engine';
+import type { ChatCompletionTool } from '@lobechat/types';
+
+import type { AgentConfigWithId } from '@/server/services/agent';
+
+import { createRunFacts } from '../runFacts';
+import { discoverTools, type ToolDiscoveryDeps } from './toolDiscovery';
+
+export interface ChatCompletionToolSetDeps extends ToolDiscoveryDeps {
+  resolveAgentConfig: (
+    agentId: string,
+    overrides: { model: string; provider: string },
+  ) => Promise<{ agentConfig: AgentConfigWithId; disabledPluginIds: string[] }>;
+}
+
+export interface ChatCompletionToolSetInput {
+  agentId: string;
+  model: string;
+  /** Latest user turn; discovery reads it for turn-scoped tools. */
+  prompt: string;
+  provider: string;
+  signal?: AbortSignal;
+  topicId: string;
+}
+
+export interface ChatCompletionToolSet {
+  /** Manifests of the offered tools only, keyed by identifier. */
+  manifestMap: Record<string, LobeToolManifest>;
+  sourceMap: Record<string, ToolSource>;
+  tools: ChatCompletionTool[];
+}
+
+/**
+ * Sources whose tools `ToolExecutionService` can run from a bare request: MCP
+ * servers go through the MCP service (or the existing device tunnel for stdio
+ * and private-network servers), LobeHub Skills through the Market and Composio
+ * through its own service.
+ */
+const isRequestExecutable = (
+  identifier: string,
+  manifest: LobeToolManifest | undefined,
+  source: ToolSource | undefined,
+) => {
+  if (!manifest || isBuiltinToolIdentifier(identifier)) return false;
+  if (source === 'lobehubSkill' || source === 'composio') return true;
+  return manifest.type === 'mcp';
+};
+
+/**
+ * The agent's enabled tools that a server-side completion loop can execute on
+ * behalf of a client that has no tool loop of its own.
+ *
+ * Runs the same discovery the server agent runtime uses — installed plugins,
+ * connectors with their permission patches, LobeHub Skills, Composio, disabled
+ * entries and the model's function-calling ability — then keeps only what can
+ * execute without an agent operation. Builtin tools are left out: many of them
+ * depend on operation state (sub-agents, activation, device sessions, message
+ * persistence) that a plain completion request does not have. Device tools
+ * stay off as well (`canUseDevice: false`).
+ */
+export const resolveChatCompletionToolSet = async (
+  deps: ChatCompletionToolSetDeps,
+  input: ChatCompletionToolSetInput,
+): Promise<ChatCompletionToolSet> => {
+  const { agentId, model, prompt, provider, signal, topicId } = input;
+
+  const { agentConfig, disabledPluginIds } = await deps.resolveAgentConfig(agentId, {
+    model,
+    provider,
+  });
+
+  const discovery = await discoverTools(
+    deps,
+    {
+      agentConfig,
+      // Only the fixed-device failure path writes to it, and this call never
+      // pins a device.
+      assistantMessageId: '',
+      canUseDevice: false,
+      deviceAccessReason: 'first-party',
+      model,
+      persistAgentId: agentConfig.id,
+      prompt,
+      provider,
+      resolvedAgentId: agentConfig.id,
+      runFacts: createRunFacts({ db: deps.db, userId: deps.userId, workspaceId: deps.workspaceId }),
+      topicId,
+    },
+    {
+      disableLocalSystem: true,
+      disableSelfFeedbackIntentTool: true,
+      disabledPluginIds,
+      globalMemoryEnabled: false,
+      hasMentionedAgents: false,
+      isFixedDeviceTarget: false,
+      loadHistoryMessages: async () => [],
+      throwIfExecutionAborted: async (stage) => {
+        if (signal?.aborted) throw new Error(`Tool discovery aborted during ${stage}`);
+      },
+    },
+  );
+
+  // Offered tool name → identifier, for the executable identifiers only.
+  const resolver = new ToolNameResolver();
+  const identifierByToolName = new Map<string, string>();
+  for (const [identifier, manifest] of Object.entries(discovery.toolManifestMap) as [
+    string,
+    LobeToolManifest,
+  ][]) {
+    if (discovery.toolExecutorMap[identifier] === 'client') continue;
+    if (!isRequestExecutable(identifier, manifest, discovery.toolSourceMap[identifier])) continue;
+
+    for (const api of manifest.api ?? []) {
+      identifierByToolName.set(resolver.generate(identifier, api.name, manifest.type), identifier);
+    }
+  }
+
+  // `discovery.tools` is what the engine enabled; the manifest map also holds
+  // tools the activator could discover later, which this loop never offers.
+  const tools = ((discovery.tools ?? []) as ChatCompletionTool[]).filter((tool) =>
+    identifierByToolName.has(tool.function.name),
+  );
+  const manifestMap: Record<string, LobeToolManifest> = {};
+  for (const tool of tools) {
+    const identifier = identifierByToolName.get(tool.function.name)!;
+    manifestMap[identifier] = discovery.toolManifestMap[identifier];
+  }
+
+  return { manifestMap, sourceMap: discovery.toolSourceMap, tools };
+};
diff --git a/apps/server/src/services/nativeMobileChat/__tests__/index.test.ts b/apps/server/src/services/nativeMobileChat/__tests__/index.test.ts
