+// @vitest-environment node
+import type { ChatStreamPayload, TracePayload } from '@lobechat/types';
+import { TraceNameMap } from '@lobechat/types';
+import { describe, expect, it } from 'vitest';
+
+import { resolveNativeMobileToolLoopTarget } from '../target';
+
+const androidHeaders = new Headers({ 'user-agent': 'LobeHub-Mobile/android-v1.0.22' });
+
+const payload: ChatStreamPayload = {
+  messages: [{ content: 'hi', role: 'user' }],
+  model: 'deepseek/deepseek-v4.1-flash',
+  stream: true,
+  temperature: 1,
+};
+
+// As captured from the Android app: tracing disabled, agent id in `sessionId`.
+const conversationTrace: TracePayload = {
+  enabled: false,
+  sessionId: 'agt_1',
+  topicId: 'tpc_1',
+  traceName: TraceNameMap.Conversation,
+};
+
+describe('resolveNativeMobileToolLoopTarget', () => {
+  it('targets the agent and topic of a native mobile conversation turn', () => {
+    expect(
+      resolveNativeMobileToolLoopTarget({
+        headers: androidHeaders,
+        payload,
+        trace: conversationTrace,
+      }),
+    ).toEqual({ agentId: 'agt_1', topicId: 'tpc_1' });
+  });
+
+  it('leaves topic title generation a plain completion', () => {
+    expect(
+      resolveNativeMobileToolLoopTarget({
+        headers: androidHeaders,
+        payload,
+        trace: { ...conversationTrace, traceName: TraceNameMap.SummaryTopicTitle },
+      }),
+    ).toBeUndefined();
+  });
+
+  it('ignores web and desktop clients', () => {
+    expect(
+      resolveNativeMobileToolLoopTarget({
+        headers: new Headers({ 'user-agent': 'Mozilla/5.0' }),
+        payload,
+        trace: conversationTrace,
+      }),
+    ).toBeUndefined();
+  });
+
+  it('leaves a client that sends its own tools alone', () => {
+    expect(
+      resolveNativeMobileToolLoopTarget({
+        headers: androidHeaders,
+        payload: {
+          ...payload,
+          tools: [{ function: { name: 'x', parameters: {} }, type: 'function' }],
+        },
+        trace: conversationTrace,
+      }),
+    ).toBeUndefined();
+  });
+
+  it('needs both the agent and the topic', () => {
+    expect(
+      resolveNativeMobileToolLoopTarget({
+        headers: androidHeaders,
+        payload,
+        trace: { ...conversationTrace, topicId: undefined },
+      }),
+    ).toBeUndefined();
+    expect(
+      resolveNativeMobileToolLoopTarget({ headers: androidHeaders, payload, trace: undefined }),
+    ).toBeUndefined();
+  });
+
+  it('skips non-streaming requests', () => {
+    expect(
+      resolveNativeMobileToolLoopTarget({
+        headers: androidHeaders,
+        payload: { ...payload, stream: false },
+        trace: conversationTrace,
+      }),
+    ).toBeUndefined();
+  });
+});
