@@ -0,0 +1,259 @@
+import { ToolNameResolver } from '@lobechat/context-engine';
+import type { LobeChatDatabase } from '@lobechat/database';
+import type { ChatMethodOptions, ModelRuntime } from '@lobechat/model-runtime';
+import type {
+  ChatStreamPayload,
+  ChatToolPayload,
+  MessageToolCall,
+  TracePayload,
+  UserInterventionConfig,
+} from '@lobechat/types';
+import { TRPCError } from '@trpc/server';
+import debug from 'debug';
+
+import { ConnectorModel } from '@/database/models/connector';
+import { ConnectorToolModel } from '@/database/models/connectorTool';
+import { MessageModel } from '@/database/models/message';
+import { PluginModel } from '@/database/models/plugin';
+import { TopicModel } from '@/database/models/topic';
+import { UserModel } from '@/database/models/user';
+import { resolveToolTimeoutMs } from '@/server/modules/AgentRuntime/resolveToolTimeout';
+import { AgentService } from '@/server/services/agent';
+import { AgentDocumentsService } from '@/server/services/agentDocuments';
+import {
+  type ChatCompletionToolSet,
+  resolveChatCompletionToolSet,
+} from '@/server/services/aiAgent/pipeline/chatCompletionToolSet';
+import { resolveRunAgentConfig } from '@/server/services/aiAgent/pipeline/resolveRunAgentConfig';
+import { ComposioService } from '@/server/services/composio';
+import { MarketService } from '@/server/services/market';
+import { mcpService } from '@/server/services/mcp';
+import { ToolExecutionService } from '@/server/services/toolExecution';
+import { BuiltinToolsExecutor } from '@/server/services/toolExecution/builtin';
+
+import { resolveNativeMobileToolLoopTarget } from './target';
+import { APPROVAL_UNAVAILABLE_RESULT, requiresHumanApproval } from './toolCallPolicy';
+import { runChatToolLoop } from './toolLoop';
+
+const log = debug('lobe-server:native-mobile-chat');
+
+export interface NativeMobileChatParams {
+  /** Options the plain completion would be called with (user, metadata, trace). */
+  chatOptions: ChatMethodOptions;
+  headers: Headers;
+  modelRuntime: ModelRuntime;
+  payload: ChatStreamPayload;
+  provider: string;
+  serverDB: LobeChatDatabase;
+  signal?: AbortSignal;
+  trace?: TracePayload;
+  userId: string;
+  workspaceId?: string;
+}
+
+const latestUserText = (payload: ChatStreamPayload) => {
+  const message = payload.messages.findLast((item) => item.role === 'user');
+  if (!message) return '';
+  if (typeof message.content === 'string') return message.content;
+  return message.content
+    .map((part) => (part.type === 'text' ? part.text : ''))
+    .filter(Boolean)
+    .join('\n');
+};
+
+const mergeCallbacks = (
+  base: ChatMethodOptions['callback'],
+  loop: NonNullable<ChatMethodOptions['callback']>,
+): NonNullable<ChatMethodOptions['callback']> => ({
+  ...base,
+  onCompletion: async (data) => {
+    await base?.onCompletion?.(data);
+    await loop.onCompletion?.(data);
+  },
+  onToolsCalling: async (data) => {
+    await base?.onToolsCalling?.(data);
+    await loop.onToolsCalling?.(data);
+  },
+});
+
+const resolveToolSet = async (
+  params: NativeMobileChatParams,
+  target: { agentId: string; topicId: string },
+): Promise<ChatCompletionToolSet | undefined> => {
+  const { payload, provider, serverDB: db, signal, userId, workspaceId } = params;
+
+  // The trace header is client data: the topic must be the caller's own, and
+  // belong to the agent the header names.
+  const topic = await new TopicModel(db, userId, workspaceId).findById(target.topicId);
+  if (!topic || (topic.agentId && topic.agentId !== target.agentId)) {
+    log('topic %s is not an own topic of agent %s, skipping tools', target.topicId, target.agentId);
+    return;
+  }
+
+  const agentService = new AgentService(db, userId, workspaceId);
+  const toolSet = await resolveChatCompletionToolSet(
+    {
+      agentDocumentsService: new AgentDocumentsService(db, userId, workspaceId),
+      composioService: new ComposioService({ db, userId, workspaceId }),
+      connectorModel: new ConnectorModel(db, userId, workspaceId),
+      connectorToolModel: new ConnectorToolModel(db, userId, workspaceId),
+      db,
+      getMarketService: async () => {
+        const settings = await new UserModel(db, userId).getUserSettings().catch((error) => {
+          console.error('[nativeMobileChat] failed to read market token:', error);
+          return undefined;
+        });
+        return new MarketService({
+          accessToken: (settings?.market as { accessToken?: string } | undefined)?.accessToken,
+          userInfo: { userId },
+        });
+      },
+      messageModel: new MessageModel(db, userId, workspaceId),
+      pluginModel: new PluginModel(db, userId, workspaceId),
+      resolveAgentConfig: (identifier, overrides) =>
+        resolveRunAgentConfig(
+          {
+            db,
+            resolveAgentConfigOrThrow: async (id) => {
+              const config = await agentService.getAgentConfig(id);
+              if (!config) throw new TRPCError({ code: 'NOT_FOUND', message: 'Agent not found' });
+              return config;
+            },
+            userId,
+            workspaceId,
+          },
+          {
+            identifier,
+            modelOverride: overrides.model,
+            providerOverride: overrides.provider,
+            throwIfExecutionAborted: async () => {},
+          },
+        ),
+      userId,
+      workspaceId,
+    },
+    {
+      agentId: target.agentId,
+      model: payload.model,
+      prompt: latestUserText(payload),
+      provider,
+      signal,
+      topicId: target.topicId,
+    },
+  );
+
+  return toolSet.tools.length > 0 ? toolSet : undefined;
+};
+
+const readInterventionConfig = async (db: LobeChatDatabase, userId: string) => {
+  try {
+    const settings = await new UserModel(db, userId).getUserSettings();
+    return (settings?.tool as { humanIntervention?: UserInterventionConfig } | undefined)
+      ?.humanIntervention;
+  } catch (error) {
+    // Unknown settings fall back to manual approval — the strictest mode.
+    console.error('[nativeMobileChat] failed to read approval settings:', error);
+    return undefined;
+  }
+};
+
+/**
+ * Serve a native mobile conversation turn with the agent's enabled tools.
+ *
+ * Returns `undefined` when the request is not such a turn, or the agent has no
+ * tool this path can run, and the caller should serve the plain completion
+ * exactly as before. Setup failures degrade the same way: the user still gets
+ * an answer, just without tools.
+ */
+export const chatWithNativeMobileTools = async (
+  params: NativeMobileChatParams,
+): Promise<Response | undefined> => {
+  const { chatOptions, headers, modelRuntime, payload, serverDB, signal, trace, userId } = params;
+  const target = resolveNativeMobileToolLoopTarget({ headers, payload, trace });
+  if (!target) return;
+
+  let toolSet: ChatCompletionToolSet | undefined;
+  try {
+    toolSet = await resolveToolSet(params, target);
+  } catch (error) {
+    if (signal?.aborted) throw error;
+    console.error('[nativeMobileChat] tool discovery failed, serving without tools:', error);
+    return;
+  }
+  if (!toolSet) return;
+
+  log(
+    'serving agent %s topic %s with %d tool(s)',
+    target.agentId,
+    target.topicId,
+    toolSet.tools.length,
+  );
+
+  const { manifestMap, sourceMap, tools } = toolSet;
+  const offeredNames = tools.map((tool) => tool.function.name);
+  const resolver = new ToolNameResolver();
+  const interventionConfig = await readInterventionConfig(serverDB, userId);
+  const toolExecutionService = new ToolExecutionService({
+    builtinToolsExecutor: new BuiltinToolsExecutor(serverDB, userId),
+    mcpService,
+  });
+
+  const executeToolCall = async (toolCall: MessageToolCall, loopSignal: AbortSignal) => {
+    const [resolved] = resolver.resolve([toolCall], manifestMap, offeredNames);
+    if (!resolved) return `Tool "${toolCall.function.name}" is not available.`;
+
+    const call: ChatToolPayload = { ...resolved, source: sourceMap[resolved.identifier] };
+    const manifest = manifestMap[call.identifier];
+    if (await requiresHumanApproval(call, manifest, interventionConfig)) {
+      log('refused %s:%s: approval required', call.identifier, call.apiName);
+      return APPROVAL_UNAVAILABLE_RESULT;
+    }
+
+    let args: Record<string, unknown> | undefined;
+    try {
+      args = JSON.parse(call.arguments || '{}');
+    } catch {
+      args = undefined;
+    }
+
+    const execution = toolExecutionService.executeTool(call, {
+      agentId: target.agentId,
+      executionTimeoutMs: resolveToolTimeoutMs({ apiName: call.apiName, args, manifest }),
+      serverDB,
+      toolCallId: call.id,
+      toolManifestMap: manifestMap,
+      topicId: target.topicId,
+      userId,
+      workspaceId: params.workspaceId,
+    });
+    // A cancelled request stops waiting; work already handed to a tool server
+    // cannot be recalled and finishes in the background.
+    let onAbort: (() => void) | undefined;
+    const aborted = new Promise<never>((_, reject) => {
+      onAbort = () => reject(loopSignal.reason);
+      if (loopSignal.aborted) onAbort();
+      else loopSignal.addEventListener('abort', onAbort, { once: true });
+    });
+    try {
+      const result = await Promise.race([execution, aborted]);
+      return result.content;
+    } finally {
+      if (onAbort) loopSignal.removeEventListener('abort', onAbort);
+    }
+  };
+
+  let isFirstStep = true;
+  return runChatToolLoop({
+    chat: (stepPayload, callback, loopSignal) => {
+      // Tracing covers one generation; later steps are served untraced.
+      const options: ChatMethodOptions = isFirstStep
+        ? { ...chatOptions, callback: mergeCallbacks(chatOptions.callback, callback) }
+        : { metadata: chatOptions.metadata, user: chatOptions.user, callback };
+      isFirstStep = false;
+      return modelRuntime.chat(stepPayload, { ...options, signal: loopSignal });
+    },
+    executeToolCall,
+    payload: { ...payload, tools },
+    signal,
+  });
+};
