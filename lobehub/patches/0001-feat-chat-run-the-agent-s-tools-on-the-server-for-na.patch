+// @vitest-environment node
+import type { LobeToolManifest } from '@lobechat/context-engine';
+import { describe, expect, it } from 'vitest';
+
+import { requiresHumanApproval } from '../toolCallPolicy';
+
+const manifest = (humanIntervention?: unknown): LobeToolManifest =>
+  ({
+    api: [
+      {
+        description: 'Run a shell command',
+        humanIntervention,
+        name: 'run',
+        parameters: { properties: {}, type: 'object' },
+      },
+    ],
+    identifier: 'shell-mcp',
+    meta: { title: 'Shell' },
+    type: 'mcp',
+  }) as LobeToolManifest;
+
+const call = (args: Record<string, unknown> = {}) => ({
+  apiName: 'run',
+  arguments: JSON.stringify(args),
+  identifier: 'shell-mcp',
+});
+
+describe('requiresHumanApproval', () => {
+  it('runs a tool without an intervention policy in the default manual mode', async () => {
+    expect(await requiresHumanApproval(call(), manifest(), undefined)).toBe(false);
+  });
+
+  it('refuses a tool that asks for approval in manual mode', async () => {
+    expect(await requiresHumanApproval(call(), manifest('required'), undefined)).toBe(true);
+    expect(
+      await requiresHumanApproval(call(), manifest('required'), { approvalMode: 'manual' }),
+    ).toBe(true);
+  });
+
+  it('honours auto-run for overridable approvals only', async () => {
+    const autoRun = { approvalMode: 'auto-run' as const };
+
+    expect(await requiresHumanApproval(call(), manifest('required'), autoRun)).toBe(false);
+    expect(await requiresHumanApproval(call(), manifest('always'), autoRun)).toBe(true);
+  });
+
+  it('refuses a call on the security blacklist even in auto-run', async () => {
+    expect(
+      await requiresHumanApproval(call({ command: 'rm -rf /' }), manifest(), {
+        approvalMode: 'auto-run',
+      }),
+    ).toBe(true);
+  });
+
+  it('runs only allow-listed tools in allow-list mode', async () => {
+    expect(
+      await requiresHumanApproval(call(), manifest('required'), {
+        allowList: ['shell-mcp/run'],
+        approvalMode: 'allow-list',
+      }),
+    ).toBe(false);
+    expect(
+      await requiresHumanApproval(call(), manifest(), {
+        allowList: ['other/run'],
+        approvalMode: 'allow-list',
+      }),
+    ).toBe(true);
+  });
+
+  it('treats a dynamic policy as needing approval', async () => {
+    expect(
+      await requiresHumanApproval(
+        call(),
+        manifest({ dynamic: { default: 'never', type: 'pathScope' } }),
+        { approvalMode: 'auto-run' },
+      ),
+    ).toBe(true);
+  });
+
+  it('refuses a tool without a manifest', async () => {
+    expect(await requiresHumanApproval(call(), undefined, undefined)).toBe(true);
+  });
+});
diff --git a/apps/server/src/services/nativeMobileChat/__tests__/toolLoop.test.ts b/apps/server/src/services/nativeMobileChat/__tests__/toolLoop.test.ts
new file mode 100644
index 0000000000..8b8d71c48b
--- /dev/null
+++ b/apps/server/src/services/nativeMobileChat/__tests__/toolLoop.test.ts
@@ -0,0 +1,273 @@
+// @vitest-environment node
+import type { ChatStreamPayload, MessageToolCall } from '@lobechat/types';
+import { describe, expect, it, vi } from 'vitest';
+
+import type { ToolLoopChat } from '../toolLoop';
+import { runChatToolLoop, TOOL_STEP_LIMIT_NOTICE } from '../toolLoop';
+
+interface FakeStep {
+  events: [event: string, data: unknown][];
+  text?: string;
+  toolCalls?: MessageToolCall[];
+}
+
+const sse = (events: FakeStep['events']) =>
+  events.map(([event, data]) => `id: chat_1\nevent: ${event}\ndata: ${JSON.stringify(data)}\n\n`);
+
+/**
+ * Stands in for `modelRuntime.chat`: streams the step's SSE events and fires
+ * the completion callbacks the real runtime fires while the body is read.
+ */
+const fakeChat = (steps: FakeStep[]) => {
+  const payloads: ChatStreamPayload[] = [];
+  const signals: AbortSignal[] = [];
+  const chat = vi.fn<ToolLoopChat>(async (payload, callback, signal) => {
+    const step = steps[Math.min(payloads.length, steps.length - 1)];
+    payloads.push(payload);
+    signals.push(signal);
+    if (step.toolCalls)
+      await callback.onToolsCalling?.({ chunk: [], toolsCalling: step.toolCalls });
+    await callback.onCompletion?.({ text: step.text ?? '', toolsCalling: step.toolCalls });
+
+    // Split mid-event to exercise the parser's buffering.
+    const body = sse(step.events).join('');
+    const chunks = [body.slice(0, 7), body.slice(7)];
+    return new Response(
+      new ReadableStream({
+        start(controller) {
+          for (const chunk of chunks) controller.enqueue(new TextEncoder().encode(chunk));
+          controller.close();
+        },
+      }),
+      { headers: { 'content-type': 'text/event-stream' } },
+    );
+  });
+  return { chat, payloads, signals };
+};
+
+const readEvents = async (response: Response) => {
+  const text = await response.text();
+  return text
+    .split('\n\n')
+    .filter(Boolean)
+    .map((block) => {
+      const event = block.match(/^event: (.*)$/m)?.[1];
+      const data = block.match(/^data: (.*)$/m)?.[1];
+      return [event, data === undefined ? undefined : JSON.parse(data)] as const;
+    });
+};
+
+const weatherCall: MessageToolCall = {
+  function: { arguments: '{"city":"Paris"}', name: 'meteoblue____getWeather____mcp' },
+  id: 'call_1',
+  type: 'function',
+};
+
+const payload: ChatStreamPayload = {
+  messages: [
+    { content: 'system prompt', role: 'system' },
+    { content: 'Weather in Paris?', role: 'user' },
+  ],
+  model: 'deepseek/deepseek-v4.1-flash',
+  stream: true,
+  temperature: 1,
+  tools: [
+    {
+      function: { name: 'meteoblue____getWeather____mcp', parameters: { type: 'object' } },
+      type: 'function',
+    },
+  ],
+};
+
+describe('runChatToolLoop', () => {
+  it('passes a response without tool calls through unchanged', async () => {
+    const { chat } = fakeChat([
+      {
+        events: [
+          ['reasoning', 'thinking'],
+          ['reasoning_signature', 'sig'],
+          ['text', 'Hello'],
+          ['stop', 'stop'],
+          ['usage', { totalTokens: 3 }],
+        ],
+        text: 'Hello',
+      },
+    ]);
+    const executeToolCall = vi.fn();
+
+    const response = await runChatToolLoop({ chat, executeToolCall, payload });
+
+    expect(await readEvents(response)).toEqual([
+      ['reasoning', 'thinking'],
+      ['text', 'Hello'],
+      ['reasoning_signature', 'sig'],
+      ['stop', 'stop'],
+      ['usage', { totalTokens: 3 }],
+    ]);
+    expect(chat).toHaveBeenCalledTimes(1);
+    expect(executeToolCall).not.toHaveBeenCalled();
+  });
+
+  it('executes tool calls on the server and streams only the combined answer', async () => {
+    const { chat, payloads } = fakeChat([
+      {
+        events: [
+          ['reasoning', 'need weather'],
+          ['reasoning_signature', 'sig-1'],
+          ['text', 'Checking.'],
+          ['tool_calls', [{ function: weatherCall.function, id: 'call_1', index: 0 }]],
+          ['stop', 'tool_calls'],
+          ['usage', { cost: 0.5, totalTokens: 10 }],
+          ['speed', { tps: 1 }],
+        ],
+        text: 'Checking.',
+        toolCalls: [weatherCall],
+      },
+      {
+        events: [
+          ['text', 'It is 20°C.'],
+          ['stop', 'stop'],
+          ['usage', { cost: 0.25, totalTokens: 5 }],
+          ['speed', { tps: 2 }],
+        ],
+        text: 'It is 20°C.',
+      },
+    ]);
+    const executeToolCall = vi.fn(async () => '{"temperature":20}');
+
+    const response = await runChatToolLoop({ chat, executeToolCall, payload });
+
+    expect(await readEvents(response)).toEqual([
+      ['reasoning', 'need weather'],
+      ['text', 'Checking.'],
+      ['text', '\n\n'],
+      ['text', 'It is 20°C.'],
+      ['stop', 'stop'],
+      ['usage', { cost: 0.75, totalTokens: 15 }],
+      ['speed', { tps: 2 }],
+    ]);
+    expect(executeToolCall).toHaveBeenCalledWith(weatherCall, expect.any(AbortSignal));
+
+    // The follow-up request replays the conversation plus the tool round.
+    expect(payloads[1].tools).toEqual(payload.tools);
+    expect(payloads[1].model).toBe(payload.model);
+    expect(payloads[1].temperature).toBe(1);
+    expect(payloads[1].messages).toEqual([
+      ...payload.messages,
+      { content: 'Checking.', role: 'assistant', tool_calls: [weatherCall] },
+      {
+        content: '{"temperature":20}',
+        name: weatherCall.function.name,
+        role: 'tool',
+        tool_call_id: 'call_1',
+      },
+    ]);
+  });
+
+  it('hands a failing tool back to the model as a tool result', async () => {
+    const { chat, payloads } = fakeChat([
+      { events: [['stop', 'tool_calls']], toolCalls: [weatherCall] },
+      { events: [['text', 'The tool failed.']], text: 'The tool failed.' },
+    ]);
+    const executeToolCall = vi.fn(async () => {
+      throw new Error('MCP server unreachable');
+    });
+
+    const events = await readEvents(await runChatToolLoop({ chat, executeToolCall, payload }));
+
+    expect(events).toContainEqual(['text', 'The tool failed.']);
+    expect(payloads[1].messages.at(-1)).toMatchObject({
+      content: 'Tool execution failed: MCP server unreachable',
+      role: 'tool',
+    });
+  });
+
+  it('stops at the step limit and says so', async () => {
+    const { chat } = fakeChat([
+      {
+        events: [
+          ['text', 'again'],
+          ['stop', 'tool_calls'],
+        ],
+        text: 'again',
+        toolCalls: [weatherCall],
+      },
+    ]);
+    const executeToolCall = vi.fn(async () => 'ok');
+
+    const events = await readEvents(
+      await runChatToolLoop({ chat, executeToolCall, maxSteps: 3, payload }),
+    );
+
+    expect(chat).toHaveBeenCalledTimes(3);
+    expect(executeToolCall).toHaveBeenCalledTimes(2);
+    expect(events.at(-2)).toEqual(['text', TOOL_STEP_LIMIT_NOTICE]);
+    expect(events.at(-1)).toEqual(['stop', 'tool_calls']);
+  });
+
+  it('forwards a provider error from a later step and ends the stream', async () => {
+    const { chat } = fakeChat([
+      { events: [['stop', 'tool_calls']], toolCalls: [weatherCall] },
+      { events: [['error', { message: 'quota exceeded', type: 'ProviderBizError' }]] },
+    ]);
+
+    const events = await readEvents(
+      await runChatToolLoop({ chat, executeToolCall: async () => 'ok', payload }),
+    );
+
+    expect(events).toEqual([['error', { message: 'quota exceeded', type: 'ProviderBizError' }]]);
+  });
+
+  it('reports a later step that fails to start as an error event', async () => {
+    const { chat } = fakeChat([{ events: [['stop', 'tool_calls']], toolCalls: [weatherCall] }]);
+    chat.mockImplementationOnce(chat.getMockImplementation()!).mockRejectedValueOnce({
+      error: { message: 'Invalid API key' },
+      errorType: 'InvalidProviderAPIKey',
+    });
+
+    const events = await readEvents(
+      await runChatToolLoop({ chat, executeToolCall: async () => 'ok', payload }),
+    );
+
+    expect(events).toEqual([
+      [
+        'error',
+        {
+          body: { message: 'Invalid API key' },
+          message: 'Invalid API key',
+          type: 'InvalidProviderAPIKey',
+        },
+      ],
+    ]);
+  });
+
+  it('rejects when the first model call fails, like a plain completion', async () => {
+    const chat = vi.fn<ToolLoopChat>().mockRejectedValue({ errorType: 'InvalidProviderAPIKey' });
+
+    await expect(
+      runChatToolLoop({ chat, executeToolCall: async () => 'ok', payload }),
+    ).rejects.toEqual({ errorType: 'InvalidProviderAPIKey' });
+  });
+
+  it('stops the loop when the client goes away', async () => {
+    const { chat, signals } = fakeChat([
+      { events: [['stop', 'tool_calls']], toolCalls: [weatherCall] },
+    ]);
+    const requestController = new AbortController();
+    const executeToolCall = vi.fn(async () => {
+      requestController.abort();
+      return 'late result';
+    });
+
+    const response = await runChatToolLoop({
+      chat,
+      executeToolCall,
+      payload,
+      signal: requestController.signal,
+    });
+    await response.text();
+
+    expect(signals[0].aborted).toBe(true);
+    expect(chat).toHaveBeenCalledTimes(1);
+  });
+});
