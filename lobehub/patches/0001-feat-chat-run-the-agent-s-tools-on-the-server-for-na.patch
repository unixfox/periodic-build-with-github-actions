@@ -0,0 +1,42 @@
+import type { ChatStreamPayload, TracePayload } from '@lobechat/types';
+import { TraceNameMap } from '@lobechat/types';
+import { parseClientMetadata } from '@lobechat/utils/server';
+
+export interface NativeMobileToolLoopTarget {
+  agentId: string;
+  topicId: string;
+}
+
+/**
+ * Whether a `/webapi/chat` request is a native mobile conversation turn that
+ * the server should serve with the agent's tools.
+ *
+ * The native apps (LobeHub-Mobile/android-v1.0.22 as captured) send no tool
+ * definitions and have no tool loop. Their only link to the agent is the
+ * `X-lobe-trace` header, sent even with tracing disabled: `sessionId` carries
+ * the agent id and `topicId` the topic. `traceName` tells the conversation
+ * turn apart from auxiliary requests such as topic-title generation, which
+ * must stay plain completions.
+ *
+ * A request that already carries `tools` is left alone: that client runs its
+ * own loop.
+ */
+export const resolveNativeMobileToolLoopTarget = ({
+  headers,
+  payload,
+  trace,
+}: {
+  headers: Headers;
+  payload: ChatStreamPayload;
+  trace?: TracePayload;
+}): NativeMobileToolLoopTarget | undefined => {
+  if (parseClientMetadata(headers).type !== 'mobile') return;
+  if (trace?.traceName !== TraceNameMap.Conversation) return;
+  if (payload.stream === false || payload.tools?.length) return;
+
+  const agentId = trace.sessionId;
+  const topicId = trace.topicId;
+  if (!agentId || !topicId) return;
+
+  return { agentId, topicId };
+};
